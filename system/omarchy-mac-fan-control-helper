#!/bin/bash
set -euo pipefail

PATH=/usr/bin:/usr/sbin
export PATH

state_dir=/var/lib/omarchy-mac-fan-control
backup="$state_dir/mbpfan.conf.original"
config=/etc/mbpfan.conf

die() { echo "mac-fan-control: $*" >&2; exit 1; }
[[ $(id -u) -eq 0 ]] || die "this helper must run as root"

smc_directory() {
  local candidate
  for candidate in /sys/devices/platform/applesmc.*; do
    [[ -d "$candidate" && -e "$candidate/fan1_manual" ]] && { printf '%s\n' "$candidate"; return; }
  done
  return 1
}

set_all_fans_max() {
  local smc fan max_file stem
  smc=$(smc_directory) || die "Apple SMC fan interface not found"
  for max_file in "$smc"/fan*_max; do
    [[ -r "$max_file" ]] || continue
    stem=${max_file%_max}
    fan=$(<"$max_file")
    [[ "$fan" =~ ^[0-9]+$ && "$fan" -ge 1000 ]] || die "invalid maximum fan speed"
    # Set the target before taking manual control. If either write fails,
    # release this fan back to firmware control before exiting.
    printf '%s\n' "$fan" >"${stem}_output" || {
      printf '0\n' >"${stem}_manual" 2>/dev/null || true
      die "could not set maximum speed"
    }
    printf '1\n' >"${stem}_manual" || {
      printf '0\n' >"${stem}_manual" 2>/dev/null || true
      die "could not enable manual fan control"
    }
  done
}

validate_curve() {
  [[ ${1:-} =~ ^[0-9]+$ && ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] || die "temperatures must be integers"
  (( $1 >= 35 && $1 <= 55 )) || die "low temperature must be 35–55°C"
  (( $2 >= 45 && $2 <= 62 )) || die "high temperature must be 45–62°C"
  (( $3 >= 60 && $3 <= 80 )) || die "maximum temperature must be 60–80°C"
  (( $1 < $2 && $2 < $3 )) || die "temperatures must satisfy LOW < HIGH < MAX"
}

install -d -m 0700 "$state_dir"
[[ -f "$backup" ]] || die "original mbpfan configuration backup is missing; reinstall the plugin"

start_mbpfan() {
  systemctl disable --now omarchy-mac-fan-max.service 2>/dev/null || true
  systemctl enable mbpfan.service || return 1
  systemctl restart mbpfan.service || return 1
}

recover_automatic_control() {
  install -m 0644 "$backup" "$config" 2>/dev/null || true
  if systemctl enable mbpfan.service >/dev/null 2>&1 && systemctl restart mbpfan.service; then
    printf 'auto\n' >/run/omarchy-mac-fan-control.mode
    return 0
  fi
  systemctl start omarchy-mac-fan-max.service 2>/dev/null || true
  return 1
}

case "${1:-}" in
  auto)
    install -m 0644 "$backup" "$config"
    start_mbpfan || {
      recover_automatic_control || true
      die "could not start mbpfan automatic control"
    }
    printf 'auto\n' >/run/omarchy-mac-fan-control.mode
    ;;
  cool)
    validate_curve "${2:-}" "${3:-}" "${4:-}"
    config_tmp=$(mktemp /etc/mbpfan.conf.XXXXXX)
    trap 'rm -f "$config_tmp"' EXIT
    awk -v low="$2" -v high="$3" -v max="$4" '
      /^[[:space:]]*low_temp[[:space:]]*=/  { print "low_temp = " low; next }
      /^[[:space:]]*high_temp[[:space:]]*=/ { print "high_temp = " high; next }
      /^[[:space:]]*max_temp[[:space:]]*=/  { print "max_temp = " max; next }
      { print }
    ' "$backup" >"$config_tmp"
    grep -Eq "^[[:space:]]*low_temp[[:space:]]*=[[:space:]]*$2([[:space:]]|$)" "$config_tmp" && grep -Eq "^[[:space:]]*high_temp[[:space:]]*=[[:space:]]*$3([[:space:]]|$)" "$config_tmp" && grep -Eq "^[[:space:]]*max_temp[[:space:]]*=[[:space:]]*$4([[:space:]]|$)" "$config_tmp" || die "the saved mbpfan configuration is missing a temperature setting"
    install -m 0644 "$config_tmp" "$config"
    if ! start_mbpfan; then
      recover_automatic_control || true
      die "could not start the cool curve; attempted to restore automatic control"
    fi
    printf 'cool\n' >/run/omarchy-mac-fan-control.mode
    ;;
  max)
    systemctl disable omarchy-mac-fan-max.service 2>/dev/null || true
    if ! systemctl start omarchy-mac-fan-max.service; then
      recover_automatic_control || true
      die "could not start maximum mode; attempted to restore automatic control"
    fi
    printf 'max\n' >/run/omarchy-mac-fan-control.mode
    ;;
  hold-max)
    [[ -z ${PKEXEC_UID:-} ]] || die "hold-max is reserved for the system service"
    trap 'exit 0' TERM INT
    while true; do
      set_all_fans_max
      sleep 2 & wait $!
    done
    ;;
  *)
    die "usage: $0 {auto|max|cool LOW HIGH MAX|hold-max}"
    ;;
esac
